NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Spracherkennung (33B.2A) — nur serverseitig, niemals NEXT_PUBLIC_
# Vollständiges Audio wird an den Provider übertragen.
# DPA/AVV, EU-Region und Retention müssen vor Produktivnutzung separat freigegeben werden.
DEEPGRAM_API_KEY=
# Optional:
# DEEPGRAM_API_BASE_URL=https://api.deepgram.com

# ── Inbound E-Mail (Resend) — nur serverseitig ──
# INBOUND_EMAIL_AGENCY_ID=
# INBOUND_EMAIL_ACTOR_USER_ID=
# RESEND_API_KEY=
# RESEND_WEBHOOK_SECRET=

# ── Inbound WhatsApp (Meta Cloud API / Testnummer) — nur serverseitig ──
# KEINE produktive WhatsApp-Nummer hier konfigurieren.
# WHATSAPP_VERIFY_TOKEN=your-verify-token
# WHATSAPP_ACCESS_TOKEN=your-temporary-or-system-user-token
# META_APP_SECRET=your-meta-app-secret
# INBOUND_WHATSAPP_AGENCY_ID=your-agency-uuid
# INBOUND_WHATSAPP_ACTOR_USER_ID=your-actor-user-uuid
# WHATSAPP_PHONE_NUMBER_ID=your-test-phone-number-id
# WHATSAPP_BUSINESS_ACCOUNT_ID=your-test-waba-id
# Optional:
# WHATSAPP_GRAPH_API_VERSION=v21.0
# Nur Development/Test — in Production NIEMALS setzen (wird ignoriert / Secret Pflicht):
# WHATSAPP_SKIP_SIGNATURE_VERIFY=true

# ── Inbound Kfz Landingpage (Gate 2) — nur serverseitig ──
# POST https://app.artkus.de/api/inbound/kfz
# Authorization: Bearer <INBOUND_KFZ_INTAKE_SECRET>
# INBOUND_KFZ_AGENCY_ID=your-agency-uuid
# INBOUND_KFZ_ACTOR_USER_ID=your-actor-user-uuid
# INBOUND_KFZ_INTAKE_SECRET=your-long-random-shared-secret
# Optional (in-memory rate-limit seam; Production: shared store Follow-up):
# INBOUND_KFZ_RATE_LIMIT_MAX=30
# INBOUND_KFZ_RATE_LIMIT_WINDOW_MS=60000
# Agency/Actor dürfen alternativ die bestehenden INBOUND_EMAIL_* Werte wiederverwenden.
